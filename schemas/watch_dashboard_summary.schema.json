{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wardpulse.app/schemas/watch_dashboard_summary.schema.json",
  "title": "WatchDashboardSummary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "dataMode",
    "generatedAt",
    "overallStatus",
    "rings",
    "creditsGlance",
    "today",
    "week",
    "allowances",
    "providers",
    "alerts",
    "isStale",
    "manualRefreshAllowed",
    "manualRefreshAvailableAt"
  ],
  "properties": {
    "schemaVersion": { "const": 9 },
    "dataMode": { "enum": ["live", "mock"] },
    "generatedAt": { "type": "string", "format": "date-time" },
    "overallStatus": { "$ref": "dashboard_snapshot.schema.json#/$defs/providerStatus" },
    "manualRefreshAllowed": {
      "type": "boolean",
      "description": "Whether a Wear Glance refresh tap may request a phone sync right now (phone PollCadence hard floor, not the Settings auto-poll slider)."
    },
    "manualRefreshAvailableAt": {
      "description": "When manual refresh becomes allowed again under the PollCadence floor. Null when already allowed.",
      "anyOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    },
    "rings": {
      "type": "array",
      "maxItems": 3,
      "description": "Ordered concentric rings (tightest remaining first). Plan/budget percent only; purchased meters are not rings.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "usedPercent", "status", "spent", "limit", "split"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Stable ring metric id. Never an account id or credential."
          },
          "label": { "type": "string", "minLength": 1 },
          "usedPercent": { "type": "number", "minimum": 0 },
          "status": { "$ref": "dashboard_snapshot.schema.json#/$defs/providerStatus" },
          "spent": {
            "description": "Budget rings only: spend behind the ring, shown on the face strip. Null for allowance rings.",
            "anyOf": [
              { "$ref": "budget_state.schema.json#/$defs/money" },
              { "type": "null" }
            ]
          },
          "limit": {
            "description": "Budget rings only: the limit this connection's period was given. Null for allowance rings.",
            "anyOf": [
              { "$ref": "budget_state.schema.json#/$defs/money" },
              { "type": "null" }
            ]
          },
          "split": {
            "description": "The other pool of the same plan, drawn as the outer half of this one band (WATCH_RING_DESIGN.md, Split band). One entry stays one band, so three entries stay three bands. Null for every ring that is not a pair. Plan pools carry no money, so no spent/limit here.",
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "label", "usedPercent", "status"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "label": { "type": "string", "minLength": 1 },
                  "usedPercent": { "type": "number", "minimum": 0 },
                  "status": { "$ref": "dashboard_snapshot.schema.json#/$defs/providerStatus" }
                }
              },
              { "type": "null" }
            ]
          }
        }
      }
    },
    "creditsGlance": {
      "description": "SHORT_TEXT remaining purchased credits for the watch strip. Null when unavailable.",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "label"],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12,
              "description": "Compact remaining credits, e.g. 500 or 1.2K. Never TOK / raw payloads."
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 24,
              "description": "Human label such as Credits left."
            },
            "provider": {
              "anyOf": [
                { "$ref": "dashboard_snapshot.schema.json#/$defs/providerKind" },
                { "type": "null" }
              ]
            }
          }
        },
        { "type": "null" }
      ]
    },
    "today": {
      "allOf": [
        { "$ref": "budget_state.schema.json" },
        {
          "type": "object",
          "properties": { "period": { "const": "today" } }
        }
      ]
    },
    "week": {
      "allOf": [
        { "$ref": "budget_state.schema.json" },
        {
          "type": "object",
          "properties": { "period": { "const": "week" } }
        }
      ]
    },
    "allowances": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "label", "usedPercent", "remaining", "resetsAt", "status"],
        "properties": {
          "source": { "$ref": "dashboard_snapshot.schema.json#/$defs/allowanceSource" },
          "label": { "type": "string" },
          "usedPercent": { "type": ["number", "null"], "minimum": 0 },
          "remaining": {
            "anyOf": [
              { "$ref": "dashboard_snapshot.schema.json#/$defs/quantity" },
              { "type": "null" }
            ]
          },
          "unlimited": { "type": "boolean" },
          "resetsAt": { "type": ["string", "null"], "format": "date-time" },
          "status": { "$ref": "dashboard_snapshot.schema.json#/$defs/providerStatus" }
        }
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "status", "todaySpent"],
        "properties": {
          "provider": { "$ref": "dashboard_snapshot.schema.json#/$defs/providerKind" },
          "status": { "$ref": "dashboard_snapshot.schema.json#/$defs/providerStatus" },
          "todaySpent": {
            "anyOf": [
              { "$ref": "budget_state.schema.json#/$defs/money" },
              { "type": "null" }
            ]
          }
        }
      }
    },
    "alerts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "message"],
        "properties": {
          "severity": { "enum": ["info", "warning", "error"] },
          "message": { "type": "string" }
        }
      }
    },
    "isStale": { "type": "boolean" }
  }
}
