# Local physical-device profile. Copy only after proving .env is ignored; use mode 600.
# Literal KEY=value data: no quotes, expansion, escapes or inline comments.
# Empty fields are intentional. Do not place real device data or secrets in this example.

# Current adb devices serial: USB serial, wireless host:connection-port or mDNS transport.
PHONE_ADB_SERIAL=
# Expected ro.product.model, hardware ID property/value, and ro.build.version.sdk.
# HARDWARE_ID_PROPERTY may be ro.serialno or ro.boot.serialno after owner confirmation.
PHONE_EXPECTED_MODEL=
PHONE_HARDWARE_ID_PROPERTY=
PHONE_EXPECTED_HARDWARE_ID=
PHONE_EXPECTED_SDK=
# Optional pin or pattern; fill only under explicit owner unlock AND storage permission.
# PIN stays literal text. Pattern is ordered comma-separated 1–9 grid nodes, row-major.
PHONE_UNLOCK_METHOD=
PHONE_UNLOCK_SECRET=

WEAR_ADB_SERIAL=
WEAR_EXPECTED_MODEL=
WEAR_HARDWARE_ID_PROPERTY=
WEAR_EXPECTED_HARDWARE_ID=
WEAR_EXPECTED_SDK=
WEAR_UNLOCK_METHOD=
WEAR_UNLOCK_SECRET=
