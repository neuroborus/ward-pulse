# Generated bindings are reproducible. Keep directory placeholders.
bindings/**/generated/*
!bindings/**/generated/.gitkeep

# Local toolchain copies for sandboxed gate runs; never committed.
.toolchains/

# Agent worktrees (isolated checkouts created by Claude Code)
.claude/worktrees/

# Release signing. `key.properties` names the keystore and its passwords; the
# keystore itself belongs outside this repository entirely. Flutter's own
# android/.gitignore covers the phone module only, and the release key is shared
# with the Wear app and the watch face, so the rule is repeated here for the
# whole tree. See docs/product/RELEASE_CHECKLIST.md, Signing.
key.properties
*.jks
*.keystore
