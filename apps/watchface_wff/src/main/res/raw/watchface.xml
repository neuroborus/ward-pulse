<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450">
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Metadata key="PREVIEW_TIME" value="10:08:00" />

    <Scene backgroundColor="#ff000000">
        <DigitalClock x="0" y="0" width="450" height="450">
            <TimeText
                x="0"
                y="150"
                width="450"
                height="100"
                alpha="255"
                align="CENTER"
                format="hh:mm"
                hourFormat="SYNC_TO_DEVICE">
                <Variant mode="AMBIENT" target="alpha" value="0" />
                <Font
                    family="SYNC_TO_DEVICE"
                    size="104"
                    weight="NORMAL"
                    slant="NORMAL"
                    color="#ffffffff" />
            </TimeText>
            <TimeText
                x="0"
                y="150"
                width="450"
                height="100"
                alpha="0"
                align="CENTER"
                format="hh:mm"
                hourFormat="SYNC_TO_DEVICE">
                <Variant mode="AMBIENT" target="alpha" value="255" />
                <Font
                    family="SYNC_TO_DEVICE"
                    size="104"
                    weight="THIN"
                    slant="NORMAL"
                    color="#ffffffff" />
            </TimeText>
        </DigitalClock>

        <Group x="0" y="0" width="450" height="450" name="wardpulse">
            <Launch target="app.wardpulse/app.wardpulse.wear.MainActivity" />

            <Group x="0" y="0" width="450" height="450" name="summary" alpha="255">
                <Variant mode="AMBIENT" target="alpha" value="0" />

                <!--
                  Quiet watermark for the locked concentric face (between time and strips).
                  Current WFF still uses side complication slots; keep the mark centered
                  so it sits in the gap rather than on a ring slot. Bottom dissolve is in
                  drawable/wardpulse_mono.png (see tools/fade-watermark-png.py).
                -->
                <PartImage x="189" y="250" width="72" height="72" alpha="95">
                    <Image resource="wardpulse_mono" />
                </PartImage>
            </Group>

            <PartImage x="201" y="258" width="48" height="48" alpha="0">
                <Variant mode="AMBIENT" target="alpha" value="70" />
                <Image resource="wardpulse_mono" />
            </PartImage>
        </Group>

        <ComplicationSlot
            x="65"
            y="240"
            width="120"
            height="120"
            slotId="101"
            displayName="@string/today_complication"
            supportedTypes="RANGED_VALUE SHORT_TEXT EMPTY"
            isCustomizable="FALSE">
            <DefaultProviderPolicy
                primaryProvider="app.wardpulse/app.wardpulse.wear.complication.TodayComplicationDataSourceService"
                primaryProviderType="RANGED_VALUE"
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY" />
            <BoundingBox x="0" y="0" width="120" height="120" />
            <Complication type="RANGED_VALUE">
                <PartDraw x="0" y="0" width="120" height="120" alpha="255">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Arc
                        centerX="60"
                        centerY="60"
                        width="108"
                        height="108"
                        startAngle="0"
                        endAngle="360">
                        <Stroke color="#ff3f4943" thickness="8" cap="ROUND" />
                    </Arc>
                    <Arc
                        centerX="60"
                        centerY="60"
                        width="108"
                        height="108"
                        startAngle="0"
                        endAngle="0">
                        <Transform
                            target="endAngle"
                            value="[COMPLICATION.RANGED_VALUE_VALUE] * 3.6" />
                        <Stroke color="#ff65d78a" thickness="8" cap="ROUND" />
                    </Arc>
                </PartDraw>
                <PartText x="0" y="38" width="120" height="32" alpha="255">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Text align="CENTER" ellipsis="FALSE">
                        <Font family="SYNC_TO_DEVICE" size="24" color="#ff65d78a">
                            <Template>
                                %s%%
                                <Parameter expression="[COMPLICATION.TEXT]" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="0" y="96" width="120" height="18" alpha="255">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="12" color="#ffbec9c1">
                            <Template>
                                %s
                                <Parameter expression="[COMPLICATION.TITLE]" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="30" width="120" height="36" alpha="255">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Text align="CENTER" ellipsis="FALSE">
                        <Font family="SYNC_TO_DEVICE" size="26" color="#ff65d78a">
                            <Template>
                                %s%%
                                <Parameter expression="[COMPLICATION.TEXT]" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>

        <ComplicationSlot
            x="265"
            y="240"
            width="120"
            height="120"
            slotId="102"
            displayName="@string/week_complication"
            supportedTypes="RANGED_VALUE SHORT_TEXT EMPTY"
            isCustomizable="FALSE">
            <DefaultProviderPolicy
                primaryProvider="app.wardpulse/app.wardpulse.wear.complication.WeekComplicationDataSourceService"
                primaryProviderType="RANGED_VALUE"
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY" />
            <BoundingBox x="0" y="0" width="120" height="120" />
            <Complication type="RANGED_VALUE">
                <PartDraw x="0" y="0" width="120" height="120" alpha="255">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Arc
                        centerX="60"
                        centerY="60"
                        width="108"
                        height="108"
                        startAngle="0"
                        endAngle="360">
                        <Stroke color="#ff3f4943" thickness="8" cap="ROUND" />
                    </Arc>
                    <Arc
                        centerX="60"
                        centerY="60"
                        width="108"
                        height="108"
                        startAngle="0"
                        endAngle="0">
                        <Transform
                            target="endAngle"
                            value="[COMPLICATION.RANGED_VALUE_VALUE] * 3.6" />
                        <Stroke color="#ff65d78a" thickness="8" cap="ROUND" />
                    </Arc>
                </PartDraw>
                <PartText x="0" y="38" width="120" height="32" alpha="255">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Text align="CENTER" ellipsis="FALSE">
                        <Font family="SYNC_TO_DEVICE" size="24" color="#ff65d78a">
                            <Template>
                                %s%%
                                <Parameter expression="[COMPLICATION.TEXT]" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="0" y="96" width="120" height="18" alpha="255">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="12" color="#ffbec9c1">
                            <Template>
                                %s
                                <Parameter expression="[COMPLICATION.TITLE]" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="30" width="120" height="36" alpha="255">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Text align="CENTER" ellipsis="FALSE">
                        <Font family="SYNC_TO_DEVICE" size="26" color="#ff65d78a">
                            <Template>
                                %s%%
                                <Parameter expression="[COMPLICATION.TEXT]" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>

        <ComplicationSlot
            x="48"
            y="348"
            width="354"
            height="24"
            slotId="104"
            displayName="@string/tokens_complication"
            supportedTypes="SHORT_TEXT EMPTY"
            isCustomizable="FALSE">
            <DefaultProviderPolicy
                primaryProvider="app.wardpulse/app.wardpulse.wear.complication.TokensComplicationDataSourceService"
                primaryProviderType="SHORT_TEXT"
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY" />
            <BoundingBox x="0" y="0" width="354" height="24" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="354" height="24" alpha="255">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="15" color="#ff65d78a">
                            <Template>
                                %s
                                <Parameter expression="[COMPLICATION.TEXT]" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>

        <ComplicationSlot
            x="48"
            y="378"
            width="354"
            height="28"
            slotId="103"
            displayName="@string/status_complication"
            supportedTypes="SHORT_TEXT EMPTY"
            isCustomizable="FALSE">
            <DefaultProviderPolicy
                primaryProvider="app.wardpulse/app.wardpulse.wear.complication.StatusComplicationDataSourceService"
                primaryProviderType="SHORT_TEXT"
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY" />
            <BoundingBox x="0" y="0" width="354" height="28" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="354" height="28" alpha="255">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="16" color="#ffbec9c1">
                            <Template>
                                %s
                                <Parameter expression="[COMPLICATION.TEXT]" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>
    </Scene>
</WatchFace>
