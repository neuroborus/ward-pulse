        </PartDraw>
        <ComplicationSlot
            x="0"
            y="0"
            width="450"
            height="450"
            slotId="101"
            displayName="@string/ring1_complication"
            supportedTypes="RANGED_VALUE EMPTY"
            isCustomizable="FALSE">
            <DefaultProviderPolicy
                primaryProvider="app.wardpulse/app.wardpulse.wear.complication.TodayComplicationDataSourceService"
                primaryProviderType="RANGED_VALUE"
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY" />
            <BoundingArc
                centerX="225"
                centerY="225"
                width="392"
                height="392"
                thickness="25"
                startAngle="0"
                endAngle="359.9"
                isRoundEdge="TRUE" />
            <Complication type="RANGED_VALUE">
                <Condition>
                    <Expressions>
                        <Expression name="hasRing">
                            <![CDATA[[COMPLICATION.RANGED_VALUE_VALUE] > 0]]>
                        </Expression>
                    </Expressions>
                    <Compare expression="hasRing">
                        <Group x="0" y="0" width="450" height="450" name="ring1">
                            <PartDraw x="0" y="0" width="450" height="450">
                                <Arc
                                    centerX="225"
                                    centerY="225"
                                    width="392"
                                    height="392"
                                    startAngle="0"
                                    endAngle="359.9">
                                    <Stroke color="#ff2e3632" thickness="25" cap="ROUND" />
                                </Arc>
                            </PartDraw>
                            <PartDraw x="0" y="0" width="450" height="450" alpha="255">
                                <Variant mode="AMBIENT" target="alpha" value="140" />
                                <Arc
                                    centerX="225"
                                    centerY="225"
                                    width="392"
                                    height="392"
                                    startAngle="0"
                                    endAngle="359.9">
                                    <Transform
                                        target="startAngle"
                                        value="(1 - ([COMPLICATION.RANGED_VALUE_VALUE] / [COMPLICATION.RANGED_VALUE_MAX])) * 359.9" />
                                    <WeightedStroke
                                        thickness="25"
                                        colors="[COMPLICATION.RANGED_VALUE_COLORS]"
                                        cap="ROUND" />
                                </Arc>
                            </PartDraw>
                        </Group>
                    </Compare>
                </Condition>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>

