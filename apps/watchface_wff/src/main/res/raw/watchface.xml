<?xml version="1.0" encoding="utf-8"?>
<!--
  Concentric remaining arcs + sunk token strip
  (docs/product/WATCH_RING_DESIGN.md, baseline 2026-07-25).

  WFF v2: WeightedStroke reads family color from
  [COMPLICATION.RANGED_VALUE_COLORS] (Wear ColorRamp).
  Arc sweep = RANGED_VALUE remaining → 360° (Wear sends remaining, not used).

  NoData / zero-value slots often still bind the RANGED_VALUE or SHORT_TEXT
  layout with empty fields — Conditions hide chrome so preview and live empty
  states do not show ROUND caps or "..." strips.
-->
<WatchFace width="450" height="450">
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Metadata key="PREVIEW_TIME" value="10:08:00" />

    <Scene backgroundColor="#ff101412">
        <ComplicationSlot
            x="0"
            y="0"
            width="450"
            height="450"
            slotId="101"
            displayName="@string/ring1_complication"
            supportedTypes="RANGED_VALUE EMPTY"
            isCustomizable="FALSE">
            <DefaultProviderPolicy
                primaryProvider="app.wardpulse/app.wardpulse.wear.complication.TodayComplicationDataSourceService"
                primaryProviderType="RANGED_VALUE"
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY" />
            <BoundingArc
                centerX="225"
                centerY="225"
                width="400.5"
                height="400.5"
                thickness="15.3"
                startAngle="0"
                endAngle="360"
                isRoundEdge="TRUE" />
            <Complication type="RANGED_VALUE">
                <Condition>
                    <Expressions>
                        <Expression name="hasRing">
                            <![CDATA[[COMPLICATION.RANGED_VALUE_VALUE] > 0]]>
                        </Expression>
                    </Expressions>
                    <Compare expression="hasRing">
                        <Group x="0" y="0" width="450" height="450" name="ring1">
                            <PartDraw x="0" y="0" width="450" height="450">
                                <Arc
                                    centerX="225"
                                    centerY="225"
                                    width="400.5"
                                    height="400.5"
                                    startAngle="0"
                                    endAngle="360">
                                    <Stroke color="#ff2e3632" thickness="15.3" cap="ROUND" />
                                </Arc>
                            </PartDraw>
                            <PartDraw x="0" y="0" width="450" height="450" alpha="255">
                                <Variant mode="AMBIENT" target="alpha" value="140" />
                                <Arc
                                    centerX="225"
                                    centerY="225"
                                    width="400.5"
                                    height="400.5"
                                    startAngle="0"
                                    endAngle="0">
                                    <Transform
                                        target="endAngle"
                                        value="[COMPLICATION.RANGED_VALUE_VALUE] * 3.6" />
                                    <WeightedStroke
                                        thickness="15.3"
                                        colors="[COMPLICATION.RANGED_VALUE_COLORS]"
                                        cap="ROUND" />
                                </Arc>
                            </PartDraw>
                        </Group>
                    </Compare>
                </Condition>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>

        <ComplicationSlot
            x="0"
            y="0"
            width="450"
            height="450"
            slotId="102"
            displayName="@string/ring2_complication"
            supportedTypes="RANGED_VALUE EMPTY"
            isCustomizable="FALSE">
            <DefaultProviderPolicy
                primaryProvider="app.wardpulse/app.wardpulse.wear.complication.WeekComplicationDataSourceService"
                primaryProviderType="RANGED_VALUE"
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY" />
            <BoundingArc
                centerX="225"
                centerY="225"
                width="360.9"
                height="360.9"
                thickness="15.3"
                startAngle="0"
                endAngle="360"
                isRoundEdge="TRUE" />
            <Complication type="RANGED_VALUE">
                <Condition>
                    <Expressions>
                        <Expression name="hasRing">
                            <![CDATA[[COMPLICATION.RANGED_VALUE_VALUE] > 0]]>
                        </Expression>
                    </Expressions>
                    <Compare expression="hasRing">
                        <Group x="0" y="0" width="450" height="450" name="ring2">
                            <PartDraw x="0" y="0" width="450" height="450">
                                <Arc
                                    centerX="225"
                                    centerY="225"
                                    width="360.9"
                                    height="360.9"
                                    startAngle="0"
                                    endAngle="360">
                                    <Stroke color="#ff2e3632" thickness="15.3" cap="ROUND" />
                                </Arc>
                            </PartDraw>
                            <PartDraw x="0" y="0" width="450" height="450" alpha="255">
                                <Variant mode="AMBIENT" target="alpha" value="140" />
                                <Arc
                                    centerX="225"
                                    centerY="225"
                                    width="360.9"
                                    height="360.9"
                                    startAngle="0"
                                    endAngle="0">
                                    <Transform
                                        target="endAngle"
                                        value="[COMPLICATION.RANGED_VALUE_VALUE] * 3.6" />
                                    <WeightedStroke
                                        thickness="15.3"
                                        colors="[COMPLICATION.RANGED_VALUE_COLORS]"
                                        cap="ROUND" />
                                </Arc>
                            </PartDraw>
                        </Group>
                    </Compare>
                </Condition>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>

        <ComplicationSlot
