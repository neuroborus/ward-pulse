        <DigitalClock x="0" y="0" width="450" height="450">
            <TimeText
                x="0"
                y="195"
                width="450"
                height="90"
                alpha="255"
                align="CENTER"
                format="hh:mm"
                hourFormat="SYNC_TO_DEVICE">
                <Variant mode="AMBIENT" target="alpha" value="0" />
                <Font
                    family="SYNC_TO_DEVICE"
                    size="70"
                    weight="BOLD"
                    slant="NORMAL"
                    color="#fff4fbf8" />
            </TimeText>
            <TimeText
                x="0"
                y="195"
                width="450"
                height="90"
                alpha="0"
                align="CENTER"
                format="hh:mm"
                hourFormat="SYNC_TO_DEVICE">
                <Variant mode="AMBIENT" target="alpha" value="255" />
                <Font
                    family="SYNC_TO_DEVICE"
                    size="81"
                    weight="THIN"
                    slant="NORMAL"
                    color="#fff4fbf8" />
            </TimeText>
        </DigitalClock>

        <Group x="0" y="0" width="450" height="450" name="wardpulse">
            <Launch target="app.wardpulse/app.wardpulse.wear.MainActivity" />
            <PartImage x="189" y="255" width="72" height="72" alpha="95">
                <Variant mode="AMBIENT" target="alpha" value="0" />
                <Image resource="wardpulse_mono" />
            </PartImage>
            <PartImage x="201" y="262" width="48" height="48" alpha="0">
                <Variant mode="AMBIENT" target="alpha" value="70" />
                <Image resource="wardpulse_mono" />
            </PartImage>
        </Group>

        <ComplicationSlot
            x="174"
            y="330"
            width="102"
            height="22"
            slotId="104"
            displayName="@string/tokens_complication"
            supportedTypes="SHORT_TEXT EMPTY"
            isCustomizable="FALSE">
            <DefaultProviderPolicy
                primaryProvider="app.wardpulse/app.wardpulse.wear.complication.TokensComplicationDataSourceService"
                primaryProviderType="SHORT_TEXT"
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY" />
            <BoundingBox x="0" y="0" width="102" height="22" />
            <Complication type="SHORT_TEXT">
                <Condition>
                    <Expressions>
                        <Expression name="hasText">
                            <![CDATA[length([COMPLICATION.TEXT]) > 0]]>
                        </Expression>
                    </Expressions>
                    <Compare expression="hasText">
                        <Group x="0" y="0" width="102" height="22" name="token_strip" alpha="255">
                            <Variant mode="AMBIENT" target="alpha" value="0" />
                            <PartDraw x="0" y="0" width="102" height="22">
                                <Rectangle x="0" y="0" width="102" height="22">
                                    <Fill color="#eb0b0e0c" />
                                </Rectangle>
                                <Rectangle x="0" y="2" width="3" height="18">
                                    <Fill color="#ff65d78a" />
                                </Rectangle>
                            </PartDraw>
                            <PartText x="6" y="0" width="92" height="22">
                                <Text align="CENTER" ellipsis="TRUE">
                                    <Font family="SYNC_TO_DEVICE" size="14" weight="BOLD" color="#fff4fbf8">
                                        <Template>
                                            %s
                                            <Parameter expression="[COMPLICATION.TEXT]" />
                                        </Template>
                                    </Font>
                                </Text>
                            </PartText>
                        </Group>
                    </Compare>
                </Condition>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>
    </Scene>
</WatchFace>
