<?xml version="1.0" encoding="utf-8"?>
<!--
  Concentric remaining arcs + sunk % / credits strips
  (docs/product/WATCH_RING_DESIGN.md, baseline 2026-07-25).

  Visual target: apps/wear_android/design/round-*-plan*.svg
  — radial lift background, ~20px visual stroke (WeightedStroke thickness
  compensated), rounded sunk strips (rx=6) with content-ish widths.

  BoundingArc clips ring-slot content — strips use BoundingBox slots after clock.
  Outer strip TEXT = full label (100% · 500); inner strips TEXT = digits, Template adds %%.
-->
<WatchFace width="450" height="450">
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Metadata key="PREVIEW_TIME" value="10:08:00" />

    <Scene backgroundColor="#ff0a0d0b">
        <PartDraw x="0" y="0" width="450" height="450" name="lift">
            <Ellipse x="0" y="0" width="450" height="450">
